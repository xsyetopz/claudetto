# Copy this file to `.env` and fill in the values.
# Git ignores `.env`.

# The login token of Claude Code for `just sandbox` (`claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=

# The key of <https://api.anthropic.com> for the `just sandbox` (<https://platform.claude.com/settings/keys>).
ANTHROPIC_API_KEY=

# The key of TypeSafe Jev, for the `decide` slice of the core plugin.
TYPESAFE_API_KEY=

# The key of Context7, for the library-docs skill. It is optional.
CONTEXT7_API_KEY=
