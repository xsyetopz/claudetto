# Copy this file to `.env` and fill in the values.
# Git ignores `.env`.

# The login token of Claude Code for `just sandbox` (`claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=

# The key of TypeSafe Jev. It is optional. Claude Code does not read this file: export the variable in the shell that launches Claude Code, or put it in the `env` block of the settings.
# With it, the constraint ledger and the branch gate send your messages, redacted, to `api.typesafe.ai`, and the `decide` tool is registered. The tuning runners in `tools/` load it from here with `bun --env-file=.env`.
TYPESAFE_API_KEY=

# The key of Context7, for the library-docs skill. It is optional.
CONTEXT7_API_KEY=
