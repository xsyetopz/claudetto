*.md diff=markdown
*.sh diff=bash
.githooks/* text eol=lf diff=bash

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.zip binary
*.gz binary
*.wasm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
