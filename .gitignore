.DS_Store
__pycache__/
*.py[cod]
.pytest_cache/

/external/

# Session exports of `/export` (YYYY-MM-DD-HHMMSS-<slug>.txt)
/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9][0-9][0-9][0-9][0-9][0-9]-*.txt

.env

/plugins/claudetto/evals/results/
/tests/claudetto/styles/padded/evals/results/

# Claude Code writes a `tsconfig.json` into a plugin folder that has none when a session loads the plugin, such as in `just sandbox`.
# Only the core plugin has a `tsconfig.json` from `src/`.
/plugins/*/tsconfig.json
!/plugins/claudetto/tsconfig.json

node_modules/
/.claude/worktrees/
/.agents/
/.claude/skills/claude-api
/skills-lock.json

# Local session state and research notes, not for the public repository.
/.claude/claudetto/

# Local state, cache, and scratch files of claudetto, not for the public repository.
/.claude/settings.local.json

# Personal notes of the user for this project.
/CLAUDE.local.md
