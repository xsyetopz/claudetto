{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  // The rules are in `.markdownlint.jsonc`, which the configs of the skill folders extend.
  // `.claude/` holds the commands and skills that `openspec init` generates, so its text is not ours to lint.
  // `.agents/` holds the skills that a user installs for this checkout, which git ignores, so their text is not ours to lint.
  // `.dotclaude/` holds the handover files and the spec store that the plugins write at run time, so their text is not ours to lint.
  // `src/` holds the sources and the shared parts of the generator, and the files that it generates in `plugins/` are linted.
  "globs": ["**/*.md"],
  "config": { "extends": "./.markdownlint.jsonc" },
  "ignores": [
    "node_modules/**",
    "external/**",
    ".claude/**",
    ".agents/**",
    ".dotclaude/**",
    "src/**",
    "plugins/*/evals/results/**"
  ]
}
