{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "globs": ["**/*.md"],
  "config": { "extends": "./.markdownlint.jsonc", "title-case": true },
  "customRules": ["./tools/lint/title-case.ts"],
  "ignores": [
    "node_modules/**",
    "external/**",
    ".claude/**",
    ".agents/**",
    "**/.claudetto/**",
    // `plugins/` is generated output, and `wiki/` is generated from `src/wiki/`.
    "plugins/**",
    // The wiki is frozen until the 0.2.0 tag, so the `title-case` fix waits for it.
    "wiki/**",
    "src/wiki/**",
    // A prompt fragment has the format of the Claude Code prompt, not of Markdown, and a lint fix would change its words or its size pin.
    "src/**/prompts/**"
  ]
}
