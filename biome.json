{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}",
      "!!**/.agents",
      "!!plugins/*/.claude-plugin/types",
      "!!wiki",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/*.generated.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      }
    },
    "domains": {
      "project": "recommended",
      "test": "recommended",
      "types": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "linter": {
      "enabled": true
    }
  },
  "html": {
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["**"],
      "plugins": ["./tools/lint/arrow-functions.grit"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "error"
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  },
                  {
                    "group": ["**/adapters/**"],
                    "message": "Domain code imports no adapter."
                  },
                  {
                    "group": ["**/kernel/node/**"],
                    "message": "Domain code imports no `kernel/node/`."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
