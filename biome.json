{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}",
      "!!**/.agents",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/*.generated.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    },
    "domains": {
      "project": "recommended",
      "test": "recommended",
      "types": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "linter": {
      "enabled": true
    }
  },
  "html": {
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!tests/dotclaude/fixtures/**",
        "!tests/dotclaude/import-rules.test.ts",
        "!tests/dotclaude/imports.test.ts",
        "!tests/dotclaude/settings-pin.test.ts",
        "!tests/support/**",
        "!tools/lab.ts",
        "!tools/limits.ts",
        "!tools/recipes.ts",
        "!tools/sizes.ts",
        "!tools/validate.ts",
        "!tools/bump-version.ts",
        "!tools/release.ts",
        "!tools/update.ts",
        "!plugins/dotclaude/features/guard/**",
        "!plugins/dotclaude/features/reads/**",
        "!tests/dotclaude/guard/**",
        "!tests/dotclaude/reads/**",
        "!plugins/dotclaude/features/adherence/**",
        "!tests/dotclaude/adherence/**",
        "!plugins/dotclaude/features/sembr/**",
        "!plugins/dotclaude/tests/sembr.test.ts",
        "!tests/dotclaude/sembr/**",
        "!plugins/dotclaude/features/statusline/**",
        "!tests/dotclaude/statusline/**",
        "!plugins/dotclaude/features/drift/**",
        "!plugins/dotclaude/features/setup/**",
        "!plugins/dotclaude/skills/**",
        "!plugins/dotclaude/tests/drift.test.ts",
        "!src/plugins/dotclaude/skills/**",
        "!tests/dotclaude/drift.test.ts",
        "!tests/dotclaude/setup/**",
        "!tests/dotclaude/skills.test.ts",
        "!plugins/dotclaude/agents/**",
        "!src/plugins/dotclaude/agents/**",
        "!tests/dotclaude/agents.test.ts",
        "!plugins/dotclaude-codegraph/**",
        "!src/plugins/dotclaude-codegraph/**",
        "!tests/codegraph/**",
        "!plugins/dotclaude-browser/**",
        "!src/plugins/dotclaude-browser/**",
        "!tests/browser/**",
        "!plugins/dotclaude-docs/**",
        "!src/plugins/dotclaude-docs/**",
        "!tests/docs/**",
        "!plugins/dotclaude-sessions/**",
        "!src/plugins/dotclaude-sessions/**",
        "!tests/sessions/**",
        "!plugins/dotclaude-lab/**",
        "!src/plugins/dotclaude-lab/**",
        "!tests/lab/**",
        "!tools/eval-variant.ts",
        "!tools/lock.ts",
        "!tools/measure.ts",
        "!tools/sandbox.ts",
        "!tools/start-run.ts",
        "!tools/unsandboxed.ts",
        "!plugins/dotclaude/evals/**",
        "!plugins/dotclaude/features/context/**",
        "!plugins/dotclaude/hooks/PostToolUse/**",
        "!plugins/dotclaude/hooks/legacy.ts",
        "!plugins/dotclaude/lib/**",
        "!plugins/dotclaude/tests/mod.test.ts",
        "!plugins/dotclaude/tsconfig.json",
        "!src/plugins/dotclaude/hooks/**",
                "!tests/dotclaude/context/**",
        "!tests/dotclaude/errors.test.ts",
        "!tests/dotclaude/eval-graders.test.ts",
        "!tests/dotclaude/hooks/**",
        "!tests/dotclaude/lib/**",
        "!tests/dotclaude/paths.test.ts",
        "!src/wiki/**",
        "!tools/wiki.ts",
        "!plugins/dotclaude-jev/**",
        "!src/plugins/dotclaude-jev/**",
        "!tests/jev/**",
        "!plugins/dotclaude/features/surface/**",
        "!plugins/dotclaude/tests/surface.test.ts",
        "!src/plugins/dotclaude/features/surface/**",
        "!plugins/dotclaude/settings.json",
        "!src/plugins/dotclaude/settings.json",
        "!tests/dotclaude/deferred-tools.test.ts",
        "!plugins/dotclaude/output-styles/**",
        "!src/plugins/dotclaude/output-styles/**"
      ],
      "plugins": ["./tools/lint/arrow-functions.grit"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "error"
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  },
                  {
                    "group": ["**/adapters/**"],
                    "message": "Domain code imports no adapter."
                  },
                  {
                    "group": ["**/kernel/node/**"],
                    "message": "Domain code imports no `kernel/node/`."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
