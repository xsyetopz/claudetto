{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "includes": [
      "**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc}",
      "!!**/.agents",
      "!**/slices/*/*.ts/*.json",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/*.generated.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
    ],
    "ignoreUnknown": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off"
      }
    },
    "domains": {
      "project": "recommended",
      "test": "recommended",
      "types": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "css": {
    "linter": {
      "enabled": true
    }
  },
  "json": {
    "linter": {
      "enabled": true
    }
  },
  "html": {
    "linter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": [
        "**",
        "!plugins/dotclaude-codegraph/evals/hooks.json",
        "!plugins/dotclaude-browser/evals/hooks.json",
        "!plugins/dotclaude-browser/tsconfig.json",
        "!plugins/dotclaude-lab/**",
        "!src/plugins/dotclaude-lab/**",
        "!tests/dotclaude/fixtures/**",
        "!tests/lab/**",
        "!tests/support/lock.test.ts",
        "!tests/support/unsandboxed.test.ts",
        "!tools/eval-variant.ts",
        "!tools/lock.ts",
        "!tools/measure.ts",
        "!tools/sandbox.ts",
        "!tools/start-run.ts",
        "!tools/unsandboxed.ts",
        "!plugins/dotclaude/evals/**",
        "!plugins/dotclaude/features/context/**",
        "!plugins/dotclaude/hooks/PostToolUse/**",
        "!plugins/dotclaude/hooks/legacy.ts",
        "!plugins/dotclaude/lib/**",
        "!plugins/dotclaude/tests/mod.test.ts",
        "!plugins/dotclaude/tsconfig.json",
        "!src/plugins/dotclaude/hooks/**",
        "!tests/dotclaude/context/**",
        "!tests/dotclaude/errors.test.ts",
        "!tests/dotclaude/eval-graders.test.ts",
        "!tests/dotclaude/hooks/**",
        "!tests/dotclaude/lib-feature-imports.test.ts",
        "!tests/dotclaude/lib/**",
        "!tests/dotclaude/paths.test.ts",
        "!tests/support/verdicts.ts",
        "!tests/support/lib-feature-imports.ts",
        "!src/wiki/**",
        "!tools/wiki.ts",
        "!plugins/dotclaude-jev/**",
        "!src/plugins/dotclaude-jev/**",
        "!tests/jev/**",
        "!plugins/dotclaude/features/surface/**",
        "!plugins/dotclaude/tests/surface.test.ts",
        "!src/plugins/dotclaude/features/surface/**"
      ],
      "plugins": ["./tools/lint/arrow-functions.grit"],
      "linter": {
        "rules": {
          "complexity": {
            "useArrowFunction": "error"
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/*.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["**/slices/*/domain/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../../**", "!../**/kernel/**"],
                    "message": "A slice imports only `kernel/` and its own folder."
                  },
                  {
                    "group": ["**/adapters/**"],
                    "message": "Domain code imports no adapter."
                  },
                  {
                    "group": ["**/kernel/node/**"],
                    "message": "Domain code imports no `kernel/node/`."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
