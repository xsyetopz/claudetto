// Strict Biome config for any Node repo (JS/TS, any framework). Biome 2.6.3+.
//
// For AI agents and humans:
// - Each enabled rule is "error", so `biome check` exits non-zero on it. Fix the code.
// - Do not add `biome-ignore`, `@ts-ignore`, `@ts-expect-error`, or `eslint-disable` comments,
//   and do not edit this file, to make a check pass.
// - Run `biome check --write` for safe fixes; read each remaining diagnostic and fix it by hand.
// - Run with `--error-on-warnings`: framework rules that Biome turns on from `package.json`
//   (React, Next.js, and others) keep their own severity, which can be "warn".
{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"files": {
		"includes": [
			"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,graphql,gql,html,vue,svelte,astro}",
			"!!**/.agents",
			"!!**/.biome",
			"!!**/.claude",
			"!!**/dist",
			"!!**/build",
			"!!**/coverage",
			"!!**/.next",
			"!!**/.nuxt",
			"!!**/.svelte-kit",
			"!!**/.astro",
			"!!**/.turbo",
			"!!**/*.generated.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"
		],
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		// Framework domains (react, next, vue, test runners, ...) stay unset: Biome turns each on
		// from package.json dependencies, so this file is safe in any repo.
		"domains": {
			"project": "recommended",
			"test": "recommended",
			"types": "recommended"
		},
		"rules": {
			// Recommended rules, plus the extras below. Rules that Biome recommends at
			// "info" or "warn" are raised to "error", because info and warn never fail a run.
			// No nursery rules: once Biome promotes a nursery rule, its old name stops the config from loading.
			"preset": "recommended",
			"complexity": {
				// Off: TS `noPropertyAccessFromIndexSignature` (tsc / bun check, TS4111) requires obj["key"]
				// for index signatures, while this rule rewrites it to obj.key. Keep one: the type-aware TS one.
				"useLiteralKeys": "off",
				"noAdjacentSpacesInRegex": "error",
				"noArguments": "error",
				"noBannedTypes": "error",
				"noCommaOperator": "error",
				"noEmptyTypeParameters": "error",
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 15 }
				},
				"noExcessiveNestedTestSuites": "error",
				"noExtraBooleanCast": "error",
				"noFlatMapIdentity": "error",
				"noForEach": "error",
				"noImplicitCoercions": "error",
				"noImportantStyles": "error",
				"noRedundantDefaultExport": "error",
				"noStaticOnlyClass": "error",
				"noThisInStatic": "error",
				"noUnnecessaryTemplateExpression": "error",
				"noUselessCatch": "error",
				"noUselessCatchBinding": "error",
				"noUselessConstructor": "error",
				"noUselessContinue": "error",
				"noUselessEmptyExport": "error",
				"noUselessEscapeInRegex": "error",
				"noUselessFragments": "error",
				"noUselessLabel": "error",
				"noUselessLoneBlockStatements": "error",
				"noUselessRename": "error",
				"noUselessReturn": "error",
				"noUselessStringConcat": "error",
				"noUselessStringRaw": "error",
				"noUselessSwitchCase": "error",
				"noUselessTernary": "error",
				"noUselessThisAlias": "error",
				"noUselessTypeConstraint": "error",
				"noUselessUndefined": "error",
				"noUselessUndefinedInitialization": "error",
				"useArrayFind": "error",
				"useArraySome": "error",
				"useArrowFunction": "error",
				"useDateNow": "error",
				"useFlatMap": "error",
				"useIndexOf": "error",
				"useMathMinMax": "error",
				"useNumericLiterals": "error",
				"useOptionalChain": "error",
				"useRegexLiterals": "error",
				"useRegexpTest": "error",
				"useSimpleNumberKeys": "error",
				"useWhile": "error",
				"noPlaywrightUselessAwait": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedImports": "error",
				"noUnusedInstantiation": "error",
				"noUnusedLabels": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error",
				"useParseIntRadix": "error",
				"useSingleJsDocAsterisk": "error",
				"noGlobalDirnameFilename": "error",
				"noUndeclaredDependencies": "error",
				"noUndeclaredVariables": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noDynamicNamespaceImportAccess": "error",
				"useDomNodeTextContent": "error",
				"useTopLevelRegex": "error",
				"noBarrelFile": "error",
				"noReExportAll": "error",
				"noAwaitInLoops": "error"
			},
			"security": {
				"useIframeSandbox": "error"
			},
			"style": {
				"noDescendingSpecificity": "error",
				"noDoneCallback": "error",
				"noInferrableTypes": "error",
				"noMultiAssign": "error",
				"noNamespace": "error",
				"noNegationElse": "error",
				"noNestedTernary": "error",
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"noSubstr": "error",
				"noUnusedTemplateLiteral": "error",
				"noUselessElse": "error",
				"noYodaExpression": "error",
				"useArrayLiterals": "error",
				"useAsConstAssertion": "error",
				"useBlockStatements": "error",
				"useCollapsedElseIf": "error",
				"useCollapsedIf": "error",
				"useConsistentArrayType": "error",
				"useConsistentArrowReturn": "error",
				"useConsistentBuiltinInstantiation": "error",
				"useConsistentCurlyBraces": "error",
				"useConsistentEnumValueType": "error",
				"useConsistentObjectDefinitions": "error",
				"useConsistentTypeDefinitions": "error",
				"useConst": "error",
				"useDefaultParameterLast": "error",
				"useDeprecatedReason": "error",
				"useEnumInitializers": "error",
				"useErrorCause": "error",
				"useExplicitLengthCheck": "error",
				"useExponentiationOperator": "error",
				"useExportType": "error",
				"useForOf": "error",
				"useFragmentSyntax": "error",
				"useGroupedAccessorPairs": "error",
				"useImportType": "error",
				"useImportsFirst": "error",
				"useLiteralEnumMembers": "error",
				"useNodeAssertStrict": "error",
				"useNodejsImportProtocol": "error",
				"useNumberNamespace": "error",
				"useNumericSeparators": "error",
				"useObjectSpread": "error",
				"useReadonlyClassProperties": "error",
				"useReduceTypeParameter": "error",
				"useSelfClosingElements": "error",
				"useShorthandAssign": "error",
				"useShorthandFunctionType": "error",
				"useSingleVarDeclarator": "error",
				"useSpreadOverApply": "error",
				"useSymbolDescription": "error",
				"useTemplate": "error",
				"useTestHooksInOrder": "error",
				"useTestHooksOnTop": "error",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error",
				"useTrimStartEnd": "error",
				"useUnifiedTypeSignatures": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				},
				"noDefaultExport": "error",
				"noEnum": "error",
				"noPlaywrightWaitForSelector": "error",
				"noPlaywrightElementHandle": "error",
				"noPlaywrightEval": "error"
			},
			"suspicious": {
				"noAlert": "error",
				"noApproximativeNumericConstant": "error",
				"noCatchAssign": "error",
				"noConditionalExpect": "error",
				"noConfusingLabels": "error",
				"noConfusingVoidType": "error",
				"noConstEnum": "error",
				"noConstantBinaryExpressions": "error",
				"noDeprecatedImports": "error",
				"noDeprecatedMediaType": "error",
				"noDocumentCookie": "error",
				"noDuplicateDependencies": "error",
				"noDuplicateEnumValues": "error",
				"noDuplicateFields": "error",
				"noDuplicateGraphqlOperationName": "error",
				"noDuplicateSelectors": "error",
				"noEmptyBlock": "error",
				"noEmptyBlockStatements": "error",
				"noEmptyObjectKeys": "error",
				"noEmptySource": "error",
				"noEvolvingTypes": "error",
				"noExplicitAny": "error",
				"noExtraNonNullAssertion": "error",
				"noFocusedTests": "error",
				"noForIn": "error",
				"noGlobalIsFinite": "error",
				"noGlobalIsNan": "error",
				"noIdenticalTestTitle": "error",
				"noIrregularWhitespace": "error",
				"noLoopFunc": "error",
				"noMisplacedAssertion": "error",
				"noNestedPromises": "error",
				"noOctalEscape": "error",
				"noParametersOnlyUsedInRecursion": "error",
				"noProto": "error",
				"noPrototypeBuiltins": "error",
				"noQuickfixBiome": "error",
				"noRedundantUseStrict": "error",
				"noReturnAssign": "error",
				"noSkippedTests": "error",
				"noSuspiciousSemicolonInJsx": "error",
				"noTemplateCurlyInString": "error",
				"noTsIgnore": "error",
				"noUnassignedVariables": "error",
				"noUnusedExpressions": "error",
				"noUselessEscapeInString": "error",
				"noUselessRegexBackrefs": "error",
				"noVar": "error",
				"useAdjacentOverloadSignatures": "error",
				"useArraySortCompare": "error",
				"useBiomeIgnoreFolder": "error",
				"useDefaultSwitchClauseLast": "error",
				"useErrorMessage": "error",
				"useExpect": "error",
				"useGoogleFontDisplay": "error",
				"useIsArray": "error",
				"useNumberToFixedDigitsArgument": "error",
				"useStaticResponseMethods": "error",
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["error", "warn", "info"]
					}
				},
				"noImportCycles": "error",
				"noShadow": "error",
				"noPlaywrightWaitForTimeout": "error",
				"noPlaywrightWaitForNavigation": "error",
				"noPlaywrightNetworkidle": "error",
				"noPlaywrightPagePause": "error",
				"noPlaywrightForceOption": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useExhaustiveSwitchCases": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	// Parse Vue, Svelte, and Astro templates, so imports used only in a template are not reported as unused.
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"overrides": [
		{
			// Tests may print to diagnose a run, and production code writes with `process.stdout` (the user, 2026-10-26).
			"includes": ["tests/**", "plugins/*/tests/**", "**/*.test.ts"],
			"linter": { "rules": { "suspicious": { "noConsole": "off" } } }
		},
		{
			// The hook lab of `claude-code/testing` passes `($, on)` to each test, which this rule reads as a done callback.
			"includes": ["plugins/*/tests/**"],
			"linter": { "rules": { "style": { "noDoneCallback": "off" } } }
		},
		{
			// Augmentations such as `declare global { namespace NodeJS { ... } }` need namespaces.
			"includes": ["**/*.d.ts"],
			"linter": { "rules": { "style": { "noNamespace": "off" } } }
		},
		{
			// Vue rules that Biome recommends at "info" or "warn".
			"includes": ["**/*.vue"],
			"linter": {
				"rules": {
					"style": {
						"useVueConsistentVBindStyle": "error",
						"useVueConsistentVOnStyle": "error",
						"useVueHyphenatedAttributes": "error",
						// Off: fires on Nuxt pages and single-word names such as Home.vue.
						"useVueMultiWordComponentNames": "off",
						"useVueNextTickPromise": "error"
					},
					"suspicious": {
						"noVueArrowFuncInWatch": "error",
						"useScopedStyles": "error"
					}
				}
			}
		}
	],
	"plugins": [
		"./.biome/plugins/noFunctionDeclaration.grit",
		"./.biome/plugins/noTypeAssertion.grit",
		"./.biome/plugins/noDoubleTypeAssertion.grit",
		"./.biome/plugins/useStructuredClone.grit",
		"./.biome/plugins/noSyncCall.grit",
		"./.biome/plugins/noProcessExit.grit",
		"./.biome/plugins/noArrayReduce.grit",
		"./.biome/plugins/noPromiseThen.grit",
		"./.biome/plugins/noMutableExports.grit",
		"./.biome/plugins/useSwitchForEqualityChain.grit"
	]
}
