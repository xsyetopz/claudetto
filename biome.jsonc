// The strict rules come from the biome-json package (`biome-json/strict`).
// This file holds only this repo's own settings. When a check fails, fix the code
// so it passes with every rule at full strength.
{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"extends": ["biome-json/strict"],
	"linter": {
		"rules": {
			"complexity": {
				"noPlaywrightUselessAwait": "error"
			},
			"correctness": {
				"noGlobalDirnameFilename": "error",
				"noUndeclaredDependencies": "error",
				"noUndeclaredVariables": "error"
			},
			"performance": {
				"noBarrelFile": "error",
				"noReExportAll": "error",
				"noAwaitInLoops": "error"
			},
			"style": {
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"]
					}
				},
				"noDefaultExport": "error",
				"noEnum": "error",
				"noPlaywrightWaitForSelector": "error",
				"noPlaywrightElementHandle": "error",
				"noPlaywrightEval": "error"
			},
			"suspicious": {
				"noConsole": {
					"level": "error",
					"options": {
						"allow": ["error", "warn", "info"]
					}
				},
				"noImportCycles": "error",
				"noShadow": "error",
				"noPlaywrightWaitForTimeout": "error",
				"noPlaywrightWaitForNavigation": "error",
				"noPlaywrightNetworkidle": "error",
				"noPlaywrightPagePause": "error",
				"noPlaywrightForceOption": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useExhaustiveSwitchCases": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"tests/**",
				"plugins/*/tests/**",
				"**/__tests__/**",
				"**/*.test.ts",
				"**/*.spec.ts"
			],
			"linter": {
				"rules": {
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["plugins/*/tests/**"],
			"linter": {
				"rules": {
					"style": {
						"noDoneCallback": "off"
					}
				}
			}
		},
		{
			// The Gitleaks rules are generated by `just gitleaks-rules` and checked by regenerating them and comparing the bytes (`bun tools/gitleaks/run.ts --check`, inside `just validate`). The formatter would rewrite the quotes of the one data line, which no author chose and which would fail that comparison, so it leaves the file alone. The linter still reads it.
			"includes": ["plugins/claudetto/src/secrets/gitleaks/rules.ts"],
			"formatter": { "enabled": false }
		},
		{
			// The settings schemas are the bytes `clawdipedia.cc` publishes, vendored so that the gate needs no network and compared with the published copies by digest (`bun tools/settings-schema.ts --upstream`). Reformatting them would break that comparison, and no author chose their layout.
			"includes": ["docs/keep/settings/*.schema.json"],
			"formatter": { "enabled": false }
		},
		{
			// The archive is read-only evidence of the replaced tree. Nothing builds it, and the path globs above match none of it, so every rule they relax fires there. This block comes last, because a later override wins.
			"includes": ["archive/**"],
			"linter": { "enabled": false },
			"formatter": { "enabled": false },
			"assist": { "enabled": false }
		}
	],
	"plugins": [
		"./node_modules/biome-json/plugins/noFunctionDeclaration.grit",
		"./node_modules/biome-json/plugins/noTypeAssertion.grit",
		"./node_modules/biome-json/plugins/noDoubleTypeAssertion.grit",
		"./node_modules/biome-json/plugins/useStructuredClone.grit",
		"./node_modules/biome-json/plugins/noSyncCall.grit",
		"./node_modules/biome-json/plugins/noProcessExit.grit",
		"./node_modules/biome-json/plugins/noArrayReduce.grit",
		"./node_modules/biome-json/plugins/noPromiseThen.grit",
		"./node_modules/biome-json/plugins/noMutableExports.grit",
		"./node_modules/biome-json/plugins/useSwitchForEqualityChain.grit"
	],
	"vcs": {
		"defaultBranch": "main"
	}
}
