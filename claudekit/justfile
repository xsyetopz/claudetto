set shell := ["sh", "-cu"]

# Run the kit's own tests.
test *args:
    bun test --timeout 120000 {{args}}

# Type-check from claudekit/tsconfig.json.
types:
    bun check

# Type-check the probes' hooks against the installed Claude Code's declarations.
hooks:
    bun bin/claudekit.ts template check probes/*/plugin

# Tests, types, and hook types.
check: test types hooks
