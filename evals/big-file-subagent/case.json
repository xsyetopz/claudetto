{
  "id": "big-file-subagent",
  "kind": "big-file",
  "prompt": "data/big.log has about 1 MB of rows. Use a subagent to find the audit code in it, and write the code in ANSWER.md. Change no other file.",
  "generate": [
    {
      "path": "data/big.log",
      "bytes": 1048576,
      "needle": { "line": 6150, "text": "audit code is KX-7731" }
    }
  ],
  "tamper": ["data/big.log"],
  "resultBound": true,
  "maxTurns": 30,
  "oracle": {
    "tests": [
      {
        "name": "answer",
        "kind": "f2p",
        "cmd": ["node", "--test", ".oracle/answer.test.mjs"]
      }
    ]
  }
}
