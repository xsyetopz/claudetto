#!/usr/bin/env -S bun --no-env-file

import { readFile } from "node:fs/promises";
import { homedir, tmpdir } from "node:os";
import { join } from "node:path";
import type { PluginOptions } from "claude-code";
import { numberOption } from "../hooks/options.ts";
import { parseArgs } from "../hygiene/args.ts";
import { branchReport } from "../hygiene/branches.ts";
import { cleanCaches } from "../hygiene/mole.ts";
import { reportText, sweep } from "../hygiene/sweep.ts";
import { type Log, logged, presentProjects } from "../hygiene/roots.ts";
import { output, outputOr } from "../hygiene/trash.ts";
import { projectsOf, worktreeReport } from "../hooks/classic.SessionStart/useHygieneSweep/worktrees.ts";

const home = process.env["HOME"] || homedir();
const configDir =
	process.env["CLAUDE_CONFIG_DIR"] || join(home, ".claude");
const settings: PluginOptions = await readFile(
	join(configDir, "settings.json"),
	"utf8",
)
	.then((text) => JSON.parse(text) ?? {})
	.catch(() => ({}));
const days = numberOption(settings, "cleanupPeriodDays", 30);
const log: Log = (message) => console.error(message);

try {
	const args = parseArgs(process.argv.slice(2));
	// Claude Code keeps this file in its config folder when one is set, and in the home folder otherwise.
	const projects = await readFile(
		join(process.env["CLAUDE_CONFIG_DIR"] || home, ".claude.json"),
		"utf8",
	)
		.then(projectsOf)
		.catch(logged(log, "The project list was not read", []))
		.then(async (dirs) => presentProjects(dirs, log));
	const report = await sweep(args, {
		cwd: process.cwd(),
		projects,
		home,
		now: Date.now(),
		uid: process.getuid?.() ?? 0,
		days,
		tempBases: [process.env["CLAUDE_CODE_TMPDIR"] ?? "", "/tmp", tmpdir()].filter(
			Boolean,
		),
		configDir,
		log,
		procStart: async (pid) =>
			(await output(["ps", "-o", "lstart=", "-p", String(pid)], "/"))?.trim() ||
			undefined,
	});
	console.log(reportText(report, args.dryRun));
	console.log(
		await worktreeReport(
			outputOr(log),
			[process.cwd(), ...projects],
			args.dryRun,
		),
	);
	console.log(
		await branchReport(outputOr(log), [process.cwd(), ...projects], {
			dryRun: args.dryRun,
			remote: args.remote,
			now: Date.now(),
			limitMs: (args.trashDays ?? 7) * 86_400_000,
		}),
	);
	console.log(
		await cleanCaches(
			args.dryRun,
			join(configDir, "claudetto", "mole-clean"),
			Date.now(),
		),
	);
} catch (error) {
	console.error(String(error));
	process.exitCode = 1;
}
