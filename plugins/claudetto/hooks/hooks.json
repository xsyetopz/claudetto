{
  "$schema": "https://raw.githubusercontent.com/xsyetopz/claude-code-docs/main/schemas/claude-code-plugin-hooks.json",
  "modules": ["./register.ts"],
  "hooks": {
    "PreModelSwitch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun --no-env-file \"${CLAUDE_PLUGIN_ROOT}/slices/handoff/adapters/switch.ts\""
