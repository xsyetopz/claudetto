#!/usr/bin/env node
// Run Claude Code in a config directory apart from your own, so a test of a
// plugin cannot change your settings, sessions, or installed plugins.
//
//   dotclaude-sandbox [--dir DIR] [claude arguments...]    set up, then run claude
//   dotclaude-sandbox [--dir DIR] --clean                  remove the sandbox
//   dotclaude-sandbox [--dir DIR] --check-frontmatter ...  run one headless session with a debug log,
//                                              and print each line that names an unknown field
//
// The command loads no plugin by itself.
// Pass `--plugin-dir DIR` once for each plugin folder, as for `claude`.
// `--dir DIR` sets the sandbox directory (default: `dotclaude-sandbox` in
// the system temp folder). It holds `config/` (`CLAUDE_CONFIG_DIR`) and
// `project/`, an empty git repository that is the working directory, and
// `home/`, the HOME of claude, so that setup scripts that change shell startup
// files change only the sandbox. The
// config skips onboarding and trusts the project.
//
// `--check-frontmatter` adds `--debug-file` and `-p "Reply with OK."` to the call.
// Claude Code loads the plugin files at start, so a short prompt is enough.
// It exits 1 when the log names a field, or when the session fails.
//
// Managed settings can lock a plugin name.
// Then Claude Code ignores the `--plugin-dir` copy of it, and
// the debug log says "plugin is locked by managed settings".
//
// Login: the sandbox uses `CLAUDE_CODE_OAUTH_TOKEN` when it is set. If not, it
// reads your own login token (the macOS Keychain entry, or
// `~/.claude/.credentials.json`) and gives it to claude in its environment
// only. The token is not written to disk or printed.
// The command finds `claude` on `PATH` only. A shell function or alias does not work.

import { spawnSync } from "node:child_process";
import fs from "node:fs";
import os from "node:os";
import path from "node:path";
import { report } from "../features/sandbox/frontmatter.mjs";
import { cleanEnv, loginToken } from "../features/sandbox/login.mjs";
import {
  absolutePluginDirs,
  availableModels,
  setUp,
  which,
} from "../features/sandbox/setup.mjs";

let args = process.argv.slice(2);
// `--dir DIR` is for this command, so it does not go on to claude.
const dirAt = args.indexOf("--dir");
let dir = path.join(os.tmpdir(), "dotclaude-sandbox");
if (dirAt !== -1) {
  if (!args[dirAt + 1]) {
    console.error("--dir needs a directory.");
    process.exit(1);
  }
  dir = args[dirAt + 1];
  args.splice(dirAt, 2);
}
const root = path.resolve(dir);
const config = path.join(root, "config");
const project = path.join(root, "project");
const home = path.join(root, "home");

if (args[0] === "--help" || args[0] === "-h") {
  console.log(
    "Usage: dotclaude-sandbox [--dir DIR] [--check-frontmatter] [--plugin-dir DIR]... [claude arguments...]\n       dotclaude-sandbox [--dir DIR] --clean",
  );
  process.exit(0);
}
if (args[0] === "--clean") {
  fs.rmSync(root, { recursive: true, force: true });
  console.log(`Removed ${root}`);
  process.exit(0);
}

args = absolutePluginDirs(args);

const check = args.includes("--check-frontmatter");
let log = null;
if (check) {
  log = path.join(
    fs.mkdtempSync(
      path.join(process.env.TMPDIR || os.tmpdir(), "sandbox-frontmatter-"),
    ),
    "debug.txt",
  );
  args = [
    ...args.filter((a) => a !== "--check-frontmatter"),
    "--debug-file",
    log,
    "-p",
    "Reply with OK.",
  ];
}

setUp({ config, home, project });
const claude = which("claude");
if (!claude) {
  console.error("claude is not on PATH. Put the claude executable on PATH.");
  process.exit(1);
}
// The token is read above with the real HOME. Only the child gets the sandbox
// HOME, without the variables that point back to the real shell files.
const env = { ...cleanEnv(), CLAUDE_CONFIG_DIR: config, HOME: home };
delete env.ZDOTDIR;
delete env.XDG_CONFIG_HOME;
const token = loginToken();
if (token) env.CLAUDE_CODE_OAUTH_TOKEN = token;
else console.error("No login token found. Run /login inside the sandbox.");
// Claude Code gives no error for a `--model` that `availableModels` leaves
// out, and the session runs on another model, so the script says so.
const model = args[args.indexOf("--model") + 1];
if (args.includes("--model")) {
  const allowed = availableModels(config);
  if (
    Array.isArray(allowed) &&
    model?.startsWith("claude-") &&
    !allowed.includes(model)
  )
    console.error(
      `--model ${model} is not in availableModels of the sandbox (${allowed.join(", ")}), so Claude Code runs another model.`,
    );
}
const r = spawnSync(claude, args, { cwd: project, env, stdio: "inherit" });
if (!check) process.exit(r.status ?? 1);

if (r.status !== 0) {
  console.error(`The sandbox session failed with exit ${r.status}.`);
  process.exit(1);
}
if (!fs.existsSync(log)) {
  console.error(`The session wrote no debug log at ${log}.`);
  process.exit(1);
}
const { lines, code } = report(log, fs.readFileSync(log, "utf8"));
for (const l of lines) console.log(l);
process.exit(code);
