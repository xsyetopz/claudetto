#!/bin/sh
# Stub emulator: single-dash options only. Logs each call for the probe.
echo "$*" >> "${VEMU_LOG:-/dev/null}"
rom=""; batch=0
while [ $# -gt 0 ]; do
  case "$1" in
    -help) printf 'usage: vemu [-help] [-batch] [-logfile path] rom\n'; exit 0 ;;
    -batch) batch=1 ;;
    -logfile) shift ;;
    -*) echo "vemu: unknown option '$1'" >&2; exit 2 ;;
    *) rom=$1 ;;
  esac; shift
done
[ -z "$rom" ] && { echo "vemu: no rom given" >&2; exit 2; }
[ $batch = 1 ] || { echo "vemu: cannot open display" >&2; exit 3; }
echo "vemu 1.4: ran $rom, 120 frames, exit 0"
