				"dir": true
			},
			"repo": {
				"dir": true
			},
			"repo/openspec": {
				"dir": true
			},
			"repo/openspec/changes": {
				"dir": true
			},
			"repo/openspec/changes/test-change": {
				"dir": true
			},
			"repo/openspec/changes/test-change/specs": {
				"dir": true
			},
			"repo/openspec/changes/test-change/specs/widgets": {
				"dir": true
			},
			"repo/openspec/changes/test-change/specs/widgets/spec.md": {
				"text": "## ADDED Requirements\n\n### Requirement: Pwned\nThe system SHALL be pwned.\n\n#### Scenario: Apply\n- **WHEN** the change is archived\n- **THEN** the spec is updated\n"
			},
			"repo/openspec/specs": {
				"dir": true
			},
			"repo/openspec/specs/widgets": {
				"link": "$ROOT/outside"
			}
		},
		"after": {
			"outside": {
				"dir": true
			},
			"repo": {
				"dir": true
			},
			"repo/openspec": {
				"dir": true
			},
			"repo/openspec/changes": {
				"dir": true
			},
			"repo/openspec/changes/test-change": {
				"dir": true
			},
			"repo/openspec/changes/test-change/specs": {
				"dir": true
			},
			"repo/openspec/changes/test-change/specs/widgets": {
				"dir": true
			},
			"repo/openspec/changes/test-change/specs/widgets/spec.md": {
				"text": "## ADDED Requirements\n\n### Requirement: Pwned\nThe system SHALL be pwned.\n\n#### Scenario: Apply\n- **WHEN** the change is archived\n- **THEN** the spec is updated\n"
			},
			"repo/openspec/specs": {
				"dir": true
			},
			"repo/openspec/specs/widgets": {
				"link": "$ROOT/outside"
			}
		},
		"outcome": {
			"returned": [
				{
					"id": "widgets",
					"sourceRoot": "$ROOT/repo/openspec/changes/test-change/specs",
					"source": "$ROOT/repo/openspec/changes/test-change/specs/widgets/spec.md",
					"targetRoot": "$ROOT/outside",
					"target": "$ROOT/outside/spec.md",
					"exists": false
				}
			]
		}
	},
