	{
		"file": "specs-apply.symlink-escape.security.test.ts",
		"test": "a linked capability directory outside the project > names the real destination when the link leaves the project",
		"seq": 0,
		"kind": "apply.findSpecUpdates",
		"root": "openspec-spec-link-escape-mi45b3",
		"abs": "$ROOT",
		"hint": "$ROOT/repo/openspec/changes/test-change",
