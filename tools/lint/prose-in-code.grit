language js;

// A text in the code of a plugin with more than `CODE_TEXT_MAX_CHARS` (`tools/limits.ts`) characters, which is 60.
// A string literal counts its two quotes, so it has 63 or more characters.
// A template literal counts the sum of its own fixed parts, so a text that `${}` values cut is measured as one text.
// A template literal in a `${}` value is a text of its own.
// The count is of characters, not of words, so the rule works for each written language.

// Adds the text of a fixed part of a template literal to `$fixed`.
// The pattern gives `$part` a scope of its own, so each part binds it again.
pattern fixed_part($fixed) {
  or {
    JsTemplateChunkElement() as $part where { $fixed += $part },
    JsTemplateElement()
  }
}

or {
  JsStringLiteralExpression() as $text where { $text <: r"(?s).{63,}" },
  JsTemplateExpression(elements=$parts) as $text where {
    $fixed = "",
    $parts <: every fixed_part($fixed),
    $fixed <: r"(?s).{61,}"
  }
} where {
  // The `ladder` line, the `controls` records, and the `evals` test references of `slice.ts` are fields of the slice contract (`src/kernel/slice.ts`) that never ship as text.
  // The rule finds them by their place in the code, not by their words.
  not and {
    $filename <: r".*/slice\.ts",
    $text <: within JsPropertyObjectMember(name=r"ladder|evals|controls")
  },
  register_diagnostic(
    span = $text,
    message = "Put a long text in a `.md` file in a `prompts/` folder next to the code, and import it from the `prompts.ts` module of that folder. For data, such as a command or a captured text, add `// biome-ignore lint/plugin: <reason>`."
  )
}
