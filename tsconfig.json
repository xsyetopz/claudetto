{
  "extends": "./plugins/claudetto/tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "typeRoots": [
      "./node_modules",
      "./node_modules/@types",
      "./plugins/claudetto/.claude-plugin/types"
    ],
    "types": [
      "bun-types",
      "claude-code",
      "claude-code-mcp",
      "claude-code-tools",
      "node"
    ],
    "rootDirs": ["src", ".", "plugins/claudetto"]
  },
  "exclude": ["node_modules"],
  "include": [
    "plugins/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts",
    "src/**/*.ts"
  ]
}
